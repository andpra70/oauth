OAUTH_SERVER_IMAGE=docker.io/andpra70/oauth-server:latest
OAUTH_SERVER_RESTART=unless-stopped
OAUTH_SERVER_PORT=9000
OAUTH_SERVER_DATA_VOLUME=oauth-server-data

BASE_PATH=
PORT=9000
ISSUER=http://localhost:9000
TRUST_PROXY=false
TWO_FACTOR_ENABLED=false
CONSENT_ENABLED=false
GOOGLE_OAUTH_ENABLED=true
CONFIRM_LOGOUT=false
PASSKEY_ENABLED=true
COOKIE_KEYS=replace-me-1,replace-me-2,replace-me-3

# bootstrap admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_EMAIL=admin@example.local

# oauth client for local testing
DEFAULT_CLIENT_ID=fileserver-web
DEFAULT_CLIENT_AUTH_METHOD=none
DEFAULT_CLIENT_SECRET=secret_key_for_fileserver_web
# leave unset to derive from ISSUER/BASE_PATH
DEFAULT_CLIENT_REDIRECT_URIS=http://localhost:9000/app/callback,http://localhost:9000/authWidget/callback,http://localhost:5173/,http://localhost:5173/authWidget/callback,https://zanotti.iliadboxos.it:55443/oauth-server/authWidget/callback,https://zanotti.iliadboxos.it:55443/oauth-server/app/callback,https://zanotti.iliadboxos.it:55443/oauth-server/authWidget/callback
DEFAULT_CLIENT_POST_LOGOUT_REDIRECT_URIS=http://localhost:9000/app,http://localhost:9000/authWidget,http://localhost:5173/,http://localhost:5173/authWidget,https://zanotti.iliadboxos.it:55443/oauth-server/app,https://zanotti.iliadboxos.it:55443/oauth-server/authWidget
SETUP_TOKEN=replace-with-bootstrap-token
ALLOWED_ORIGINS=http://localhost:9000,http://localhost:8080,http://localhost:5173,http://localhost,https://zanotti.iliadboxos.it:55443


# optional google login
GOOGLE_CLIENT_ID=755876354778-0qva56dpv05vo6p86dov9oaf8m218a60.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_PATH=/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/google/callback

PASSKEY_RP_NAME=Local OAuth2 Server

