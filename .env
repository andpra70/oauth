PORT=9000
ISSUER=http://localhost:9000
TRUST_PROXY=false
COOKIE_KEYS=replace-me-1,replace-me-2,replace-me-3

# bootstrap admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme!
ADMIN_EMAIL=admin@example.local

# oauth client for local testing
DEFAULT_CLIENT_ID=fileserver-web
DEFAULT_CLIENT_SECRET=replace-with-long-random-secret
DEFAULT_CLIENT_REDIRECT_URI=http://localhost:8080/app/explorer/callback
DEFAULT_CLIENT_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/app/explorer/
SETUP_TOKEN=replace-with-bootstrap-token
