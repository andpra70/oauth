OAUTH_SERVER_IMAGE=docker.io/andpra70/oauth-server:latest
OAUTH_SERVER_RESTART=unless-stopped
OAUTH_SERVER_PORT=9000
OAUTH_SERVER_DATA_VOLUME=oauth-server-data

BASE_PATH=/oauth-server
PORT=9000
ISSUER=https://zanotti.iliadboxos.it:55443/oauth-server
TRUST_PROXY=true
TWO_FACTOR_ENABLED=false
COOKIE_KEYS=replace-me-1,replace-me-2,replace-me-3

# bootstrap admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_EMAIL=admin@example.local

# oauth client for production
DEFAULT_CLIENT_ID=fileserver-web
DEFAULT_CLIENT_AUTH_METHOD=none
DEFAULT_CLIENT_SECRET=replace-with-long-random-secret
DEFAULT_CLIENT_REDIRECT_URIS=https://zanotti.iliadboxos.it:55443/oauth-server/app/callback,https://zanotti.iliadboxos.it:55443/oauth-server/authWidget/callback
DEFAULT_CLIENT_POST_LOGOUT_REDIRECT_URIS=https://zanotti.iliadboxos.it:55443/oauth-server/app,https://zanotti.iliadboxos.it:55443/oauth-server/authWidget
SETUP_TOKEN=replace-with-bootstrap-token
ALLOWED_ORIGINS=https://zanotti.iliadboxos.it:55443


# optional google login
GOOGLE_CLIENT_ID=755876354778-0qva56dpv05vo6p86dov9oaf8m218a60.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_PATH=/oauth-server/auth/google/callback
GOOGLE_CALLBACK_URL=https://zanotti.iliadboxos.it:55443/oauth-server/auth/google/callback
