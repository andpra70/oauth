OAUTH_SERVER_IMAGE=docker.io/andpra70/oauth-server:latest
OAUTH_SERVER_RESTART=unless-stopped
OAUTH_SERVER_PORT=9000
OAUTH_SERVER_DATA_VOLUME=oauth-server-data

BASE_PATH=/oauth-server
PORT=9000
ISSUER=https://example.com/oauth-server
TRUST_PROXY=true
TWO_FACTOR_ENABLED=false
CONSENT_ENABLED=false
GOOGLE_OAUTH_ENABLED=true
CONFIRM_LOGOUT=false
PASSKEY_ENABLED=true
COOKIE_KEYS=replace-me-1,replace-me-2,replace-me-3

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_EMAIL=admin@example.local

DEFAULT_CLIENT_ID=fileserver-web
DEFAULT_CLIENT_AUTH_METHOD=none
DEFAULT_CLIENT_SECRET=replace-with-long-random-secret
SETUP_TOKEN=replace-with-bootstrap-token
ALLOWED_ORIGINS=https://example.com,https://localhost

GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_PATH=/auth/api/callback
GOOGLE_CALLBACK_URL=https://example.com/auth/api/callback

MONGO_URI=mongodb://root:change-me@mongo:27017/oauth2?authSource=admin
REDIS_URL=redis://redis:6379/0
VFS_GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
VFS_GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
VFS_GOOGLE_CALLBACK_URL=https://example.com/auth/api/callback
VFS_GOOGLE_CALLBACK_URLS=https://example.com/auth/api/callback,https://localhost/auth/api/callback
VFS_JWT_ISSUER=vfs-auth
VFS_JWT_AUDIENCE=vfs-clients
VFS_PRIVATE_KEY_PATH=/run/secrets/private.pem
ADMIN_GOOGLE_SUBS=

PASSKEY_RP_NAME=Local OAuth2 Server
