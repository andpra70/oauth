OAUTH_SERVER_IMAGE=docker.io/andpra70/oauth-server:latest
OAUTH_SERVER_RESTART=unless-stopped
OAUTH_SERVER_PORT=9000
OAUTH_SERVER_DATA_VOLUME=oauth-server-data

BASE_PATH=/oauth-server
PORT=9000
ISSUER=https://example.com/oauth-server
TRUST_PROXY=true
TWO_FACTOR_ENABLED=false
CONSENT_ENABLED=false
GOOGLE_OAUTH_ENABLED=true
CONFIRM_LOGOUT=false
PASSKEY_ENABLED=true
COOKIE_KEYS=replace-me-1,replace-me-2,replace-me-3

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_EMAIL=admin@example.local

DEFAULT_CLIENT_ID=fileserver-web
DEFAULT_CLIENT_AUTH_METHOD=none
DEFAULT_CLIENT_SECRET=replace-with-long-random-secret
SETUP_TOKEN=replace-with-bootstrap-token
ALLOWED_ORIGINS=https://example.com,https://localhost

GOOGLE_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_PATH=/auth/google/callback
GOOGLE_CALLBACK_URL=https://example.com/oauth-server/auth/google/callback

PASSKEY_RP_NAME=Local OAuth2 Server

MAIL_ENABLED=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
MAIL_FROM=no-reply@example.com
PASSWORD_RESET_PUBLIC_URL=https://example.com/oauth-server/reset-password
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
