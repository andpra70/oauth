{
  "name": "oauth2-2fa-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:ui:dev\"",
    "start": "node src/index.js",
    "ui:build": "npm run ui:build:app && npm run ui:build:profile-widget",
    "ui:build:app": "vite build",
    "ui:build:profile-widget": "vite build --config vite.profile-widget.config.js",
    "ui:dev": "vite build --mode development --watch"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "argon2": "^0.41.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "oidc-provider": "^8.5.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^4.7.0",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.1",
    "vite": "^5.4.14"
  }
}
