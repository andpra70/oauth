OAUTH_SERVER_IMAGE=docker.io/andpra70/oauth-server:latest
OAUTH_SERVER_RESTART=unless-stopped
OAUTH_SERVER_PORT=9000
OAUTH_SERVER_DATA_VOLUME=oauth-server-data

BASE_PATH=
PORT=9000
ISSUER=http://localhost:9000
TRUST_PROXY=true
TWO_FACTOR_ENABLED=true
CONSENT_ENABLED=true
GOOGLE_OAUTH_ENABLED=true
PASSKEY_ENABLED=false
CONFIRM_LOGOUT=true
COOKIE_KEYS=replace-me-1,replace-me-2,replace-me-3

# bootstrap admin user
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMeNow123!
ADMIN_EMAIL=admin@example.local

# oauth client for local testing
DEFAULT_CLIENT_ID=fileserver-web
DEFAULT_CLIENT_AUTH_METHOD=none
DEFAULT_CLIENT_SECRET=secret_key_for_fileserver_web
SETUP_TOKEN=replace-with-bootstrap-token
ALLOWED_ORIGINS=http://localhost:9000,http://localhost:8080,http://localhost

# optional google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# leave unset to derive from ISSUER/BASE_PATH
# GOOGLE_CALLBACK_PATH=
# GOOGLE_CALLBACK_URL=
GOOGLE_CALLBACK_PATH=/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:9000/auth/google/callback

# optional passkey login (WebAuthn)
# PASSKEY_RP_ID defaults to ISSUER hostname
# PASSKEY_ORIGIN defaults to ISSUER origin
PASSKEY_RP_NAME=Local OAuth2 Server
# PASSKEY_RP_ID=
# PASSKEY_ORIGIN=
